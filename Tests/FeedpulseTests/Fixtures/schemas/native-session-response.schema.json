{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedpulse.stargazy.xyz/schemas/native/native-session-response.schema.json",
  "title": "POST /v1/native/session の応答（200）",
  "type": "object",
  "required": ["session", "expiresAt"],
  "properties": {
    "session": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "expiresAt": { "type": "integer", "minimum": 0, "description": "epoch 秒" }
  },
  "additionalProperties": false
}
